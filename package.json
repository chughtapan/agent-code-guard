{
  "name": "eslint-plugin-agent-code-guard",
  "version": "0.0.19",
  "description": "Normative ESLint floor for agent-written TypeScript: Google TypeScript Style plus stricter safety, Effect, testing, and tooling rules.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-code-guard-knip": "./dist/knip.js",
    "agent-code-guard-init": "./dist/init.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc",
    "lint": "tsc --noEmit && eslint . && knip",
    "test": "vitest run --changed",
    "test:all": "vitest run",
    "bench": "tsx bench/lint-bench.ts",
    "bench:generate": "tsx bench/generate-fixture.ts",
    "mutation": "stryker run",
    "prepublishOnly": "pnpm build && pnpm test:all"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript",
    "google-style",
    "static-analysis",
    "effect",
    "kysely",
    "safer-by-default"
  ],
  "license": "MIT",
  "author": "Tapan Chugh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chughtapan/agent-code-guard.git"
  },
  "homepage": "https://github.com/chughtapan/agent-code-guard#readme",
  "bugs": {
    "url": "https://github.com/chughtapan/agent-code-guard/issues"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@typescript-eslint/utils": "8.65.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "knip": "^6.12.1",
    "typescript-eslint": "8.65.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5 <6.1.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/rule-tester": "8.65.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
